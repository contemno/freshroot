#!/bin/bash
# /etc/grub.d/06_freshroot
#
# Runs under bash (not sh) so it can source /etc/freshroot-update.conf,
# which uses bash array syntax for REPOS, BIND_MOUNTS and LINEAGE_QUOTAS.
#
# Generates GRUB menu entries for the freshroot boot model. Snapshots are
# grouped into LINEAGES (install lines: root.<lineage>.<TS>, or legacy
# root.<TS> resolved via the snapshot's os-release):
#
#   1. "<label> (clean — <lineage> — <ts>)" — DEFAULT
#      The default lineage's newest snapshot with a bootable kernel pair.
#      The default lineage is read from /boot/freshroot/default-lineage
#      (written by freshroot-install --switch), falling back to the running
#      system's lineage — so installing another release never silently
#      changes what boots.
#
#   2. One clean entry per remaining lineage, newest snapshot first.
#
#   3. "<label> (tainted)" — boots @ directly with staging masked. If the
#      default lineage has no snapshots at all, or none with a bootable
#      kernel pair, this entry is emitted FIRST (another lineage is never
#      promoted into the default slot).
#
#   4. Per-lineage snapshot-history submenus.
#
# Snapshots whose tree carries no freshroot boot-ceremony support (marker
# /usr/lib/freshroot/ceremony or the 90freshroot dracut module) get entries
# WITHOUT rd.freshroot, labeled "NO CEREMONY" — selecting one boots the
# read-only snapshot directly. A snapshot may ship /etc/freshroot/cmdline
# (single line) to replace the auto-generated rd.luks.* parameters.
#
# Kernel pairing prefers a tree's /boot/freshroot/<name>/ archive — the
# vmlinuz+initrd hardlinks frozen at snapshot commit time (written by
# freshroot-update/-build/-install; this script only READS the layout).
# Trees without a usable archive fall back to the flat names, paired only
# with kernels whose modules exist inside the target root. Flat initrds are
# looked up as /boot/initrd.img-<kver> or /boot/initramfs-<kver>.img.
#
# This script runs under plain `set -e` (no -u/pipefail) inside
# grub-mkconfig and kernel postinsts — keep per-snapshot lookups ||-guarded.

set -e

# --- Configuration ---
EDITION=""
SNAPSHOTS_DIR="@snapshots"
ROOT_SUBVOL="@"
# shellcheck source=/dev/null
[ -r /etc/freshroot-update.conf ] && . /etc/freshroot-update.conf

# Build the label: "Freshroot" or "Freshroot Workstation" etc.
if [ -n "$EDITION" ]; then
    _ed_first=$(printf '%s' "$EDITION" | cut -c1 | tr '[:lower:]' '[:upper:]')
    _ed_rest=$(printf '%s' "$EDITION" | cut -c2-)
    LABEL="Freshroot ${_ed_first}${_ed_rest}"
else
    LABEL="Freshroot"
fi

SNAPSHOT_DIR="/.snapshots"
DEFAULT_LINEAGE_FILE="/boot/freshroot/default-lineage"
BOOT_ARCHIVE_DIR="/boot/freshroot"
TAB=$(printf '\t')
BTRFS_DEVICE=$(findmnt -n -o SOURCE / | sed 's/\[.*\]//')
BTRFS_UUID=$(findmnt -n -o UUID /)
BOOT_UUID=$(findmnt -n -o UUID /boot)

# Find the LUKS UUID if applicable (for rd.luks.uuid= / rd.luks.name=)
CRYPT_UUID=""
DM_NAME=$(dmsetup info -c --noheadings -o name "$BTRFS_DEVICE" 2>/dev/null || true)
if [ -n "$DM_NAME" ]; then
    CRYPT_BACKING=$(cryptsetup status "$DM_NAME" 2>/dev/null | grep "device:" | awk '{print $2}')
    if [ -n "$CRYPT_BACKING" ]; then
        CRYPT_UUID=$(blkid -s UUID -o value "$CRYPT_BACKING" 2>/dev/null || true)
    fi
fi

# Base kernel command line, and the dracut LUKS parameters (kept separate:
# a snapshot's /etc/freshroot/cmdline replaces the LUKS part per entry).
BASE_CMDLINE="${GRUB_CMDLINE_LINUX:-}"
LUKS_CMDLINE=""
if [ -n "$CRYPT_UUID" ]; then
    echo "$BASE_CMDLINE" | grep -q "rd.luks.uuid=" || \
        LUKS_CMDLINE="rd.luks.uuid=${CRYPT_UUID} rd.luks.name=${CRYPT_UUID}=${DM_NAME}"
fi

# --- Lineage helpers ---
# SYNC (partial copy: snap_ts, snap_label, lineage_of_root, snapshot_lineage):
# the canonical versions live in freshroot-update / freshroot-build /
# freshroot-install; installer/freshroot-setup Phase 9 re-derives the lineage
# with the same parsing rules. This copy is bash but runs without set -u or
# pipefail — keep every per-snapshot lookup ||-guarded. Fix every copy
# together.

# Timestamp field of a snapshot name; empty if the name has none.
snap_ts() {
    _n="${1##*/}"; _n="${_n#root.}"; _last="${_n##*.}"
    if [[ "$_last" =~ ^[0-9]{8}T[0-9]{6}$ ]]; then
        printf '%s\n' "$_last"
    fi
}

# Lineage label encoded in a snapshot name; empty for legacy names.
snap_label() {
    _n="${1##*/}"; _n="${_n#root.}"; _last="${_n##*.}"
    if [[ "$_last" =~ ^[0-9]{8}T[0-9]{6}$ ]] && [ "${_n#*.}" != "$_n" ]; then
        printf '%s\n' "${_n%.*}"
    fi
}

# Default lineage of a root tree from its os-release (never sourced; the
# usr/lib copy is preferred and absolute /etc symlinks are re-rooted into
# the tree). Echoes "unknown" when unreadable.
lineage_of_root() {
    _root="$1"; _f=""; _id=""; _ver=""
    if [ -r "${_root}/usr/lib/os-release" ] && [ ! -L "${_root}/usr/lib/os-release" ]; then
        _f="${_root}/usr/lib/os-release"
    elif [ -L "${_root}/etc/os-release" ]; then
        _tgt=$(readlink "${_root}/etc/os-release" 2>/dev/null) || _tgt=""
        case "$_tgt" in
            /*) [ -r "${_root}${_tgt}" ] && _f="${_root}${_tgt}" ;;
            *)  [ -r "${_root}/etc/os-release" ] && _f="${_root}/etc/os-release" ;;
        esac
    elif [ -r "${_root}/etc/os-release" ]; then
        _f="${_root}/etc/os-release"
    fi
    if [ -n "$_f" ]; then
        _id=$(sed -n 's/^ID=//p' "$_f" 2>/dev/null | head -1 | tr -d '"' \
              | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-') || _id=""
        _ver=$(sed -n 's/^VERSION_ID=//p' "$_f" 2>/dev/null | head -1 | tr -d '"' \
               | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-') || _ver=""
    fi
    if [ -n "$_id" ] && [ -n "$_ver" ]; then
        printf '%s-%s\n' "$_id" "$_ver"
    elif [ -n "$_id" ]; then
        printf '%s\n' "$_id"
    else
        printf 'unknown\n'
    fi
}

# Lineage of an existing snapshot: the name label, else the tree's os-release.
snapshot_lineage() {
    _lbl=$(snap_label "$1")
    if [ -n "$_lbl" ]; then
        printf '%s\n' "$_lbl"
    else
        lineage_of_root "$1"
    fi
}

# Does the tree implement the freshroot boot ceremony?
ceremony_capable() {
    [ -f "$1/usr/lib/freshroot/ceremony" ] && return 0
    [ -f "$1/usr/lib/dracut/modules.d/90freshroot/freshroot-setup.sh" ] && return 0
    return 1
}

# Optional per-lineage cmdline snippet (replaces the rd.luks.* parameters).
lineage_cmdline() {
    if [ -r "$1/etc/freshroot/cmdline" ]; then
        head -1 "$1/etc/freshroot/cmdline" 2>/dev/null || true
    fi
}

# Human-readable timestamp for a snapshot name.
display_ts() {
    _t=$(snap_ts "$1")
    if [[ "$_t" =~ ^(....)(..)(..)T(..)(..)(..)$ ]]; then
        printf '%s-%s-%s %s:%s:%s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" \
            "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}"
    else
        printf '%s\n' "$1"
    fi
}

# --- Collect all kernels available in flat /boot, newest first ---
ALL_BOOT_KERNELS=$(for f in /boot/vmlinuz-*; do [ -e "$f" ] && echo "${f##*/vmlinuz-}"; done | sort -rV)

if [ -z "$ALL_BOOT_KERNELS" ] && \
   ! ls "${BOOT_ARCHIVE_DIR}"/*/vmlinuz-* >/dev/null 2>&1; then
    echo "Warning: No kernels found in /boot" >&2
    exit 0
fi

# --- Initrd lookup: Debian/Ubuntu naming first, then Fedora-style ---
# Resolved once per run (initrd presence per kver is invariant) so the
# per-snapshot kernel scans below stay fork-free.
declare -A INITRD_PATH=()
for _krel in $ALL_BOOT_KERNELS; do
    if [ -f "/boot/initrd.img-${_krel}" ]; then
        INITRD_PATH[$_krel]="/initrd.img-${_krel}"
    elif [ -f "/boot/initramfs-${_krel}.img" ]; then
        INITRD_PATH[$_krel]="/initramfs-${_krel}.img"
    fi
done

# --- Bootable kernel pairs frozen in a tree's /boot archive ---
# Emits "kver vmlinuz initrd" lines (paths relative to the BOOT filesystem
# root), newest first. Empty when the archive dir is missing or holds no
# complete pair.
archive_kernel_lines() {
    _adir="${BOOT_ARCHIVE_DIR}/$1"
    [ -d "$_adir" ] || return 0
    for _f in "$_adir"/vmlinuz-*; do
        [ -f "$_f" ] || continue
        _k="${_f##*/vmlinuz-}"
        if [ -f "${_adir}/initrd.img-${_k}" ]; then
            printf '%s /freshroot/%s/vmlinuz-%s /freshroot/%s/initrd.img-%s\n' \
                "$_k" "$1" "$_k" "$1" "$_k"
        elif [ -f "${_adir}/initramfs-${_k}.img" ]; then
            printf '%s /freshroot/%s/vmlinuz-%s /freshroot/%s/initramfs-%s.img\n' \
                "$_k" "$1" "$_k" "$1" "$_k"
        fi
    done | sort -rV
    return 0
}

# --- Find kernels compatible with a given root path ---
# $1 = tree root, $2 = archive name ('' = flat lookup only). Emits
# "kver vmlinuz initrd" lines, newest first. The tree's archive is
# authoritative when it holds any complete pair (it was frozen from the
# tree's own module list at commit time); otherwise a kernel is compatible
# if its modules dir exists inside the root AND a matching flat initrd
# exists in /boot.
kernels_for() {
    _root="$1"
    _kf_lines=""
    if [ -n "${2:-}" ]; then
        _kf_lines=$(archive_kernel_lines "$2") || _kf_lines=""
    fi
    if [ -n "$_kf_lines" ]; then
        printf '%s\n' "$_kf_lines"
        return 0
    fi
    for _krel in $ALL_BOOT_KERNELS; do
        if [ -d "${_root}/usr/lib/modules/${_krel}" ] && \
           [ -n "${INITRD_PATH[$_krel]-}" ]; then
            printf '%s /vmlinuz-%s %s\n' "$_krel" "$_krel" "${INITRD_PATH[$_krel]}"
        fi
    done
    return 0
}

# --- Find the newest compatible kernel for a root path ---
# $1 = tree root, $2 = archive name (''= flat lookup only).
# Sets BK_REL, BK_VMLINUZ, BK_INITRD. Returns 1 if none.
best_kernel_for() {
    _bk_line=$(kernels_for "$1" "${2:-}" | head -1)
    if [ -z "$_bk_line" ]; then
        return 1
    fi
    read -r BK_REL BK_VMLINUZ BK_INITRD <<< "$_bk_line"
    return 0
}

# --- Emit a single GRUB menu entry ---
# Reads kernel info from BK_REL, BK_VMLINUZ, BK_INITRD.
emit_entry() {
    _title="$1"
    _subvol="$2"
    _tree="$3"          # tree path for the cmdline snippet ('' = none)
    _freshroot="$4"     # "yes" to add rd.freshroot=1
    _extra="$5"         # additional kernel params

    _luks="$LUKS_CMDLINE"
    _base="$BASE_CMDLINE"
    _snippet=""
    [ -n "$_tree" ] && _snippet=$(lineage_cmdline "$_tree")
    if [ -n "$_snippet" ]; then
        # The snippet REPLACES the rd.luks.* parameters for this entry —
        # including any the admin put in GRUB_CMDLINE_LINUX, which would
        # otherwise set up a second, conflicting unlock mapping.
        _luks="$_snippet"
        _filtered=""
        for _w in $_base; do
            case "$_w" in
                rd.luks.*) ;;
                *) _filtered="${_filtered:+${_filtered} }${_w}" ;;
            esac
        done
        _base="$_filtered"
    fi

    _cmdline="root=UUID=${BTRFS_UUID} ro rootflags=subvol=${_subvol}"
    [ -n "$_luks" ] && _cmdline="${_cmdline} ${_luks}"
    [ -n "$_base" ] && _cmdline="${_cmdline} ${_base}"
    if [ "$_freshroot" = "yes" ]; then
        _cmdline="${_cmdline} rd.freshroot=1"
    fi
    [ -n "$_extra" ] && _cmdline="${_cmdline} ${_extra}"

    cat << ENTRY
menuentry '${_title}' --class ubuntu --class gnu-linux --class os {
    insmod gzio
    insmod part_gpt
    insmod btrfs

    search --no-floppy --fs-uuid --set=root ${BOOT_UUID}

    echo 'Loading kernel ${BK_REL} ...'
    linux ${BK_VMLINUZ} ${_cmdline}
    echo 'Loading initrd ...'
    initrd ${BK_INITRD}
}
ENTRY
}

# --- Ensure /.snapshots is mounted ---
# update-grub can be invoked outside freshroot-update (manual runs,
# kernel postinst, dpkg-reconfigure grub-pc). Self-mount so the snapshot
# submenu is generated regardless of caller. Clean up on exit.
_SNAPSHOT_UNMOUNT=0
if [ -d "$SNAPSHOT_DIR" ] && ! mountpoint -q "$SNAPSHOT_DIR"; then
    if mount -t btrfs -o "subvol=${SNAPSHOTS_DIR},noatime" \
            "$BTRFS_DEVICE" "$SNAPSHOT_DIR" 2>/dev/null; then
        _SNAPSHOT_UNMOUNT=1
        trap '[ "$_SNAPSHOT_UNMOUNT" = "1" ] && umount "$SNAPSHOT_DIR" 2>/dev/null || true' EXIT
    fi
fi

# --- Index read-only snapshots ---
# SNAP_INDEX lines: "TS<TAB>lineage<TAB>name", TS-sorted oldest first.
# EXTRA_SNAPSHOTS: RO root.* subvolumes without a valid TS field (excluded
# from clean entries, still listed in the history menu).
SNAP_INDEX=""
EXTRA_SNAPSHOTS=""
if [ -d "$SNAPSHOT_DIR" ]; then
    for _d in "$SNAPSHOT_DIR"/root.*/; do
        [ -d "$_d" ] || continue
        btrfs property get "${_d%/}" ro 2>/dev/null | grep -q 'ro=true' || continue
        _name="${_d%/}"; _name="${_name##*/}"
        _ts=$(snap_ts "$_name")
        if [ -n "$_ts" ]; then
            _lin=$(snapshot_lineage "${_d%/}")
            SNAP_INDEX="${SNAP_INDEX}${_ts}${TAB}${_lin}${TAB}${_name}
"
        else
            EXTRA_SNAPSHOTS="${EXTRA_SNAPSHOTS}${_name}
"
        fi
    done
    SNAP_INDEX=$(printf '%s' "$SNAP_INDEX" | sort)
fi

# All lineages, ordered by their newest snapshot (newest lineage first)
ALL_LINEAGES=$(printf '%s\n' "$SNAP_INDEX" | awk -F'\t' 'NF==3 { last[$2]=$1 } END { for (l in last) print last[l] "\t" l }' | sort -r | cut -f2)

# The default lineage: the sticky record, else the running system's lineage
N_LINEAGES=$(printf '%s\n' "$ALL_LINEAGES" | grep -c . 2>/dev/null) || N_LINEAGES=0
DEFAULT_LINEAGE=""
if [ -r "$DEFAULT_LINEAGE_FILE" ]; then
    DEFAULT_LINEAGE=$(head -1 "$DEFAULT_LINEAGE_FILE" 2>/dev/null | tr -cd 'a-zA-Z0-9._-') || DEFAULT_LINEAGE=""
fi
if [ -z "$DEFAULT_LINEAGE" ]; then
    DEFAULT_LINEAGE=$(lineage_of_root "")
    if [ "$N_LINEAGES" -gt 1 ]; then
        echo "Warning: ${DEFAULT_LINEAGE_FILE} missing with multiple lineages present — defaulting to the running lineage '${DEFAULT_LINEAGE}'; pin one with 'freshroot-install --switch'" >&2
    fi
fi

# Does the default lineage actually have snapshots?
DEFAULT_HAS_SNAPSHOTS=0
if [ -n "$ALL_LINEAGES" ] && printf '%s\n' "$ALL_LINEAGES" | grep -Fqx "$DEFAULT_LINEAGE"; then
    DEFAULT_HAS_SNAPSHOTS=1
fi

# Order lineages: default first (when it has snapshots), rest as-is
if [ "$DEFAULT_HAS_SNAPSHOTS" = "1" ]; then
    ORDERED_LINEAGES=$({ printf '%s\n' "$DEFAULT_LINEAGE"; printf '%s\n' "$ALL_LINEAGES" | grep -Fvx "$DEFAULT_LINEAGE" || true; })
else
    ORDERED_LINEAGES="$ALL_LINEAGES"
fi

# Snapshot names of a lineage, newest first
snaps_in_lineage() {
    printf '%s\n' "$SNAP_INDEX" | awk -F'\t' -v l="$1" 'NF==3 && $2==l {print $3}' | tac
}

# --- Emit the clean entry for a lineage ---
# Walks the lineage newest-to-oldest until a snapshot has a bootable kernel
# pair (warning when that is not the newest one). Returns 1 if none has.
emit_clean_for_lineage() {
    _lin="$1"
    _newest=""
    for _snap in $(snaps_in_lineage "$_lin"); do
        [ -z "$_newest" ] && _newest="$_snap"
        if best_kernel_for "${SNAPSHOT_DIR}/${_snap}" "$_snap"; then
            if [ "$_snap" != "$_newest" ]; then
                echo "Warning: lineage ${_lin}: newest snapshot ${_newest} has no bootable kernel pair — clean entry uses ${_snap}" >&2
            fi
            _ts_disp=$(display_ts "$_snap")
            _cap="yes"
            _title="${LABEL} (clean — ${_lin} — ${_ts_disp})"
            if ! ceremony_capable "${SNAPSHOT_DIR}/${_snap}"; then
                _cap=""
                _title="${LABEL} (${_lin} — ${_ts_disp} — NO CEREMONY, boots read-only)"
            fi
            emit_entry "$_title" "${SNAPSHOTS_DIR}/${_snap}" "${SNAPSHOT_DIR}/${_snap}" "$_cap" ""
            return 0
        fi
    done
    return 1
}

# --- Emit the tainted entry (boot @ directly, staging masked) ---
# The kernel is gated against the @ tree itself: / is the running clone and
# may belong to a different lineage than @.
emit_tainted() {
    _AT_MNT="/run/freshroot-grub-at"
    _at_root=""
    if mkdir -p "$_AT_MNT" 2>/dev/null && \
       mount -t btrfs -o "subvol=${ROOT_SUBVOL},ro" "$BTRFS_DEVICE" "$_AT_MNT" 2>/dev/null; then
        _at_root="$_AT_MNT"
    fi
    if [ -n "$_at_root" ] && best_kernel_for "$_at_root" "${ROOT_SUBVOL}"; then
        emit_entry \
            "${LABEL} (tainted — current root, skip rollback)" \
            "${ROOT_SUBVOL}" \
            "$_at_root" \
            "" \
            "systemd.mask=freshroot-update.service systemd.mask=freshroot-update.timer"
    elif best_kernel_for "/" "${ROOT_SUBVOL}"; then
        # Could not inspect @ (or @ has no bootable pair): fall back to the
        # running tree's view but say so in the title.
        emit_entry \
            "${LABEL} (tainted — current root, skip rollback — kernel may lack modules in ${ROOT_SUBVOL})" \
            "${ROOT_SUBVOL}" \
            "" \
            "" \
            "systemd.mask=freshroot-update.service systemd.mask=freshroot-update.timer"
    fi
    if [ -n "$_at_root" ]; then
        umount "$_AT_MNT" 2>/dev/null || true
    fi
}

# ==========================================================================
# Entries. GRUB_DEFAULT=0 boots the FIRST entry emitted here: the default
# lineage's clean entry, or — when the default lineage has no snapshots or
# no bootable one — the tainted entry (never another lineage's clean entry).
# ==========================================================================
FIRST_LINEAGE=""
REMAINING_LINEAGES="$ORDERED_LINEAGES"
if [ "$DEFAULT_HAS_SNAPSHOTS" = "1" ]; then
    FIRST_LINEAGE=$(printf '%s\n' "$ORDERED_LINEAGES" | head -1)
    REMAINING_LINEAGES=$(printf '%s\n' "$ORDERED_LINEAGES" | tail -n +2)
fi

TAINTED_DONE=0
if [ -z "$ALL_LINEAGES" ]; then
    # No timestamped snapshots. Preserve the pre-lineage invariant that the
    # lexically newest root.* snapshot is the default (e.g. a hand-pinned
    # root.golden); fall back to booting @ immutably when none exists.
    _def_emitted=0
    if [ -n "$EXTRA_SNAPSHOTS" ]; then
        _snap=$(printf '%s\n' "$EXTRA_SNAPSHOTS" | grep . | sort -r | head -1) || _snap=""
        if [ -n "$_snap" ] && best_kernel_for "${SNAPSHOT_DIR}/${_snap}" "$_snap"; then
            _cap="yes"
            _title="${LABEL} (clean — ${_snap})"
            if ! ceremony_capable "${SNAPSHOT_DIR}/${_snap}"; then
                _cap=""
                _title="${LABEL} (${_snap} — NO CEREMONY, boots read-only)"
            fi
            emit_entry "$_title" "${SNAPSHOTS_DIR}/${_snap}" "${SNAPSHOT_DIR}/${_snap}" "$_cap" ""
            _def_emitted=1
        fi
    fi
    if [ "$_def_emitted" = "0" ] && best_kernel_for "/" "${ROOT_SUBVOL}"; then
        emit_entry \
            "${LABEL} (clean — no snapshots, using ${ROOT_SUBVOL})" \
            "${ROOT_SUBVOL}" \
            "" \
            "yes" \
            ""
    fi
elif [ -z "$FIRST_LINEAGE" ]; then
    echo "Warning: default lineage ${DEFAULT_LINEAGE} has no snapshots — tainted entry promoted; pick a new default with 'freshroot-install --switch'" >&2
    emit_tainted
    TAINTED_DONE=1
elif emit_clean_for_lineage "$FIRST_LINEAGE"; then
    :
else
    echo "Warning: default lineage ${FIRST_LINEAGE} has no bootable snapshot — tainted entry promoted" >&2
    emit_tainted
    TAINTED_DONE=1
fi

for _lin in $REMAINING_LINEAGES; do
    emit_clean_for_lineage "$_lin" || \
        echo "Warning: lineage ${_lin} has no bootable snapshot in /boot" >&2
done

if [ "$TAINTED_DONE" = "0" ]; then
    emit_tainted
fi

# ==========================================================================
# History submenus: one per lineage, each snapshot with all its kernels
# ==========================================================================

# Emit one snapshot's inner submenu (one entry per compatible kernel).
# No-op when the snapshot has no bootable kernel pair.
emit_snap_submenu() {
    _snap="$1"
    _menu_title="$2"
    SNAP_KERNELS=$(kernels_for "${SNAPSHOT_DIR}/${_snap}" "$_snap")
    [ -n "$SNAP_KERNELS" ] || return 0
    _cap="yes"; _capnote=""
    if ! ceremony_capable "${SNAPSHOT_DIR}/${_snap}"; then
        _cap=""; _capnote=" — NO CEREMONY"
    fi
    echo "  submenu '${_menu_title}${_capnote}' --class ubuntu {"
    while read -r BK_REL BK_VMLINUZ BK_INITRD; do
        [ -n "$BK_REL" ] || continue
        emit_entry \
            "    kernel ${BK_REL}" \
            "${SNAPSHOTS_DIR}/${_snap}" \
            "${SNAPSHOT_DIR}/${_snap}" \
            "$_cap" \
            ""
    done <<< "$SNAP_KERNELS"
    echo "  }"
}

# True when at least one snapshot in the (whitespace-separated) list has a
# bootable kernel pair — gates whether an outer submenu is opened at all.
any_bootable_in() {
    for _snap in $1; do
        if [ -n "$(kernels_for "${SNAPSHOT_DIR}/${_snap}" "$_snap")" ]; then
            return 0
        fi
    done
    return 1
}

for _lin in $ORDERED_LINEAGES; do
    _lin_snaps=$(snaps_in_lineage "$_lin")
    [ -n "$_lin_snaps" ] || continue
    any_bootable_in "$_lin_snaps" || continue

    echo "submenu '${LABEL} — ${_lin} — Snapshot History' --class ubuntu {"
    for _snap in $_lin_snaps; do
        emit_snap_submenu "$_snap" "$(display_ts "$_snap") (${_snap})"
    done
    echo "}"
done

# Snapshots whose names carry no valid timestamp (e.g. hand-made root.golden):
# excluded from clean entries and pruning, still selectable here.
if [ -n "$EXTRA_SNAPSHOTS" ] && any_bootable_in "$EXTRA_SNAPSHOTS"; then
    echo "submenu '${LABEL} — Other Snapshots' --class ubuntu {"
    for _snap in $EXTRA_SNAPSHOTS; do
        emit_snap_submenu "$_snap" "$_snap"
    done
    echo "}"
fi
