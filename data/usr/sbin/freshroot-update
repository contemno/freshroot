#!/bin/bash
# /usr/sbin/freshroot-update
# Immutable root change script: stage updates in a btrfs snapshot via nspawn.
set -euo pipefail

INTERACTIVE=0
GUI=0
PROVISION_ONLY=0
LINEAGE_FLAG=""
FROM_REF=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --shell|-i)  INTERACTIVE=1 ;;
        --gui)       INTERACTIVE=1; GUI=1 ;;
        --provision) PROVISION_ONLY=1 ;;
        --lineage)
            [[ $# -ge 2 ]] || { echo "freshroot-update: --lineage requires an argument" >&2; exit 1; }
            LINEAGE_FLAG="$2"; shift ;;
        --lineage=*) LINEAGE_FLAG="${1#--lineage=}" ;;
        --from)
            [[ $# -ge 2 ]] || { echo "freshroot-update: --from requires an argument" >&2; exit 1; }
            FROM_REF="$2"; shift ;;
        --from=*)    FROM_REF="${1#--from=}" ;;
        -h|--help)
            cat <<'USAGE'
Usage: freshroot-update [--shell|--gui|--provision] [--lineage NAME] [--from REF]

  (no args)        Stage apt updates + REPOS scripts on the current lineage's
                   latest snapshot, commit as a new read-only snapshot.
  --shell, -i      Interactive shell in staging (exit 0 to snapshot, non-zero
                   to abort). update-grub is disabled inside staging; the host
                   runs it after commit.
  --gui            Like --shell with display/GPU/audio passthrough.
  --provision      First-boot cloud-init provisioning only.
  --lineage NAME   Operate on lineage NAME instead of the booted lineage; the
                   new snapshot is committed under this lineage label.
  --from REF       Stage from REF instead of the lineage's latest snapshot.
                   REF is a lineage name or a snapshot name (root.*).
USAGE
            exit 0 ;;
        *) echo "freshroot-update: unknown argument: $1" >&2; exit 1 ;;
    esac
    shift
done

# Lineage labels land in snapshot names and on the kernel command line
# (rootflags=subvol=...), so they must stay shell/cmdline-safe.
if [[ -n "$LINEAGE_FLAG" ]]; then
    if [[ ! "$LINEAGE_FLAG" =~ ^[a-z0-9][a-z0-9._-]*$ || "$LINEAGE_FLAG" == "unknown" ]]; then
        echo "freshroot-update: invalid --lineage '${LINEAGE_FLAG}' (allowed: lowercase alphanumerics, dot, dash, underscore; 'unknown' is reserved)" >&2
        exit 1
    fi
fi

CONF="/etc/freshroot-update.conf"
if [[ ! -f "$CONF" ]]; then
    echo "ERROR: config not found at $CONF" >&2
    exit 1
fi
# Defaults for keys the (conffile-preserved) config may predate
LINEAGE_QUOTAS=()
# shellcheck source=/dev/null
source "$CONF"
BASE_SUBVOL="${BASE_SUBVOL:-@base}"

# ── Globals ──────────────────────────────────────────────────────────
TOPLEVEL="/run/freshroot-update/btrfs-toplevel"
TS="$(date -u +%Y%m%dT%H%M%S)"
LOCKFILE="/run/freshroot-update.lock"
LOG_FILE="${LOG_DIR}/update-${TS}.log"
DEFAULT_LINEAGE_FILE="/boot/freshroot/default-lineage"

# ── Helpers ──────────────────────────────────────────────────────────
die()  { echo "FATAL: $*" | tee -a "$LOG_FILE" >&2; exit 1; }
info() { echo "[$(date -u +%H:%M:%S)] $*" | tee -a "$LOG_FILE"; }
warn() { echo "[$(date -u +%H:%M:%S)] WARNING: $*" | tee -a "$LOG_FILE" >&2; }

cleanup() {
    local rc=$?
    # Unmount staging bind mounts if still up
    mountpoint -q "${TOPLEVEL}/${STAGING_SUBVOL}${BOOT_PARTITION}" 2>/dev/null && \
        umount -R "${TOPLEVEL}/${STAGING_SUBVOL}${BOOT_PARTITION}"
    # Check (before unmounting the top-level) whether staging was left behind
    local staging_left=0
    if [[ $rc -ne 0 ]] && btrfs subvolume show "${TOPLEVEL}/${STAGING_SUBVOL}" &>/dev/null; then
        staging_left=1
    fi
    mountpoint -q "$TOPLEVEL" 2>/dev/null && umount -l "$TOPLEVEL"
    if [[ $rc -ne 0 ]]; then
        if [[ $staging_left -eq 1 ]]; then
            info "Update FAILED (exit $rc). Staging subvolume retained for investigation."
            info "  Inspect via: mount -o subvolid=5 <dev> /mnt && ls /mnt/${STAGING_SUBVOL}"
        else
            info "Update FAILED (exit $rc)."
        fi
    fi
    exit $rc
}
trap cleanup EXIT

# ── Lineage helpers ──────────────────────────────────────────────────
# A "lineage" is an install line of snapshots. The lineage label is encoded
# in the snapshot name:
#   root.<lineage>.<TS>   e.g. root.ubuntu-26.04.20260719T120000
#   root.<TS>             legacy; lineage resolved from the tree's os-release
# TS is always the LAST dot-field and must match ^[0-9]{8}T[0-9]{6}$.
# Names without a valid TS field are exempt from pruning and latest-selection.
# SYNC: these helpers are copied between freshroot-update, freshroot-build
# and freshroot-install (each omits helpers it does not use); a partial,
# ||-guarded copy (snap_ts, snap_label, lineage_of_root, snapshot_lineage —
# bash, but running under plain `set -e` without -u/pipefail) lives in
# /etc/grub.d/06_freshroot, and installer/freshroot-setup Phase 9 re-derives
# the lineage with the same parsing rules. Fix every copy together.

# Timestamp field of a snapshot name; empty if the name has none.
snap_ts() {
    local name="${1##*/}" last
    name="${name#root.}"
    last="${name##*.}"
    if [[ "$last" =~ ^[0-9]{8}T[0-9]{6}$ ]]; then
        echo "$last"
    fi
}

# Lineage label encoded in a snapshot name; empty for legacy names.
snap_label() {
    local name="${1##*/}" last
    name="${name#root.}"
    last="${name##*.}"
    if [[ "$last" =~ ^[0-9]{8}T[0-9]{6}$ && "$name" == *.* ]]; then
        echo "${name%.*}"
    fi
}

# Default lineage of a root tree from its os-release: "<ID>-<VERSION_ID>",
# "<ID>" when VERSION_ID is absent, "unknown" when unreadable. Never sources
# the file (it is snapshot-controlled data); reads usr/lib/os-release first
# (canonical regular file) and re-roots an absolute /etc/os-release symlink
# into the tree so a snapshot can never point the lookup at the host's file.
lineage_of_root() {
    local root="$1" f="" tgt id="" ver=""
    if [[ -r "${root}/usr/lib/os-release" && ! -L "${root}/usr/lib/os-release" ]]; then
        f="${root}/usr/lib/os-release"
    elif [[ -L "${root}/etc/os-release" ]]; then
        tgt=$(readlink "${root}/etc/os-release" 2>/dev/null) || tgt=""
        case "$tgt" in
            /*) [[ -r "${root}${tgt}" ]] && f="${root}${tgt}" ;;
            *)  [[ -r "${root}/etc/os-release" ]] && f="${root}/etc/os-release" ;;
        esac
    elif [[ -r "${root}/etc/os-release" ]]; then
        f="${root}/etc/os-release"
    fi
    if [[ -n "$f" ]]; then
        id=$(sed -n 's/^ID=//p' "$f" | head -1 | tr -d '"' \
             | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-')
        ver=$(sed -n 's/^VERSION_ID=//p' "$f" | head -1 | tr -d '"' \
              | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-')
    fi
    if [[ -n "$id" && -n "$ver" ]]; then
        echo "${id}-${ver}"
    elif [[ -n "$id" ]]; then
        echo "$id"
    else
        echo "unknown"
    fi
}

# Lineage of an existing snapshot: the name label, else the tree's os-release.
snapshot_lineage() {
    local snap="${1%/}" label
    label=$(snap_label "$snap")
    if [[ -n "$label" ]]; then
        echo "$label"
    else
        lineage_of_root "$snap"
    fi
}

# Retention quota for a lineage: LINEAGE_QUOTAS "lineage=N" entry, else
# MAX_SNAPSHOTS. 0 = unlimited.
lineage_quota() {
    local lin="$1" entry
    for entry in "${LINEAGE_QUOTAS[@]:-}"; do
        if [[ "$entry" == "${lin}="* ]]; then
            echo "${entry#*=}"
            return
        fi
    done
    echo "${MAX_SNAPSHOTS:-0}"
}

# List read-only snapshots as "TS<TAB>lineage<TAB>path" lines, TS-sorted
# oldest-first. Names without a valid TS field are omitted.
list_ro_snapshots() {
    local d ts lin
    for d in "${SNAP_PATH}"/*/; do
        [[ -d "$d" ]] || continue
        btrfs property get "$d" ro 2>/dev/null | grep -q 'ro=true' || continue
        ts=$(snap_ts "${d%/}")
        [[ -n "$ts" ]] || continue
        lin=$(snapshot_lineage "${d%/}")
        printf '%s\t%s\t%s\n' "$ts" "$lin" "${d%/}"
    done | sort
}

# Latest snapshot path in a lineage ('' if none).
latest_in_lineage() {
    local want="$1" found="" lin path
    while IFS=$'\t' read -r _ lin path; do
        [[ "$lin" == "$want" ]] && found="$path"
    done < <(list_ro_snapshots)
    echo "$found"
}

# Snapshot path we booted from ('' when not booted from a snapshot).
booted_snapshot() {
    local sub
    sub=$(grep -o "subvol=${SNAPSHOTS_DIR}/[^ ,]*" /proc/cmdline 2>/dev/null \
          | head -1 | sed "s|subvol=${SNAPSHOTS_DIR}/||") || true
    if [[ -n "$sub" ]]; then
        echo "${SNAP_PATH}/${sub}"
    fi
}

# Lineage this run operates on: the booted snapshot's lineage, else the
# running root's os-release (tainted boots, pre-snapshot systems).
current_lineage() {
    local b
    b=$(booted_snapshot)
    if [[ -n "$b" && -d "$b" ]]; then
        snapshot_lineage "$b"
    else
        lineage_of_root ""
    fi
}

# Record the default boot lineage on first lineage-aware run so GRUB ordering
# is sticky (changed only by freshroot-install --switch).
ensure_default_lineage() {
    local lin="$1"
    [[ -n "$lin" && "$lin" != "unknown" ]] || return 0
    [[ -s "$DEFAULT_LINEAGE_FILE" ]] && return 0
    mkdir -p "$(dirname "$DEFAULT_LINEAGE_FILE")" 2>/dev/null || return 0
    echo "$lin" > "$DEFAULT_LINEAGE_FILE" 2>/dev/null || true
}

# ── Prune old snapshots (per-lineage quotas) ─────────────────────────
# Each lineage is pruned to its own quota; lineage "unknown" (unreadable
# os-release) is never pruned automatically.
prune_snapshots() {
    local booted lin path quota
    booted=$(booted_snapshot)
    declare -A lineage_snaps=()
    while IFS=$'\t' read -r _ lin path; do
        lineage_snaps["$lin"]+="${path}"$'\n'
    done < <(list_ro_snapshots)
    for lin in "${!lineage_snaps[@]}"; do
        if [[ "$lin" == "unknown" ]]; then
            info "prune: skipping lineage 'unknown' (unresolvable os-release)"
            continue
        fi
        quota=$(lineage_quota "$lin")
        if ! [[ "$quota" =~ ^[0-9]+$ ]]; then
            warn "prune: invalid quota '${quota}' for lineage ${lin} — skipping"
            continue
        fi
        [[ "$quota" -gt 0 ]] || continue
        local -a snaps=()
        mapfile -t snaps < <(printf '%s' "${lineage_snaps[$lin]}")
        local excess=$(( ${#snaps[@]} - quota ))
        [[ $excess -gt 0 ]] || continue
        info "pruning ${excess} old snapshot(s) from lineage ${lin} (quota ${quota})"
        local i snap
        for (( i=0; i<excess; i++ )); do
            snap="${snaps[$i]}"
            if [[ -n "$booted" && "$snap" == "$booted" ]]; then
                info "  skipping (currently booted): $snap"
                continue
            fi
            info "  deleting: $snap"
            btrfs subvolume delete "$snap" || warn "failed to prune $snap"
        done
    done
}

# ── Suppress update-grub inside the staging tree ─────────────────────
# Kernel postinsts inside the container would otherwise write the host's
# grub.cfg (via the bind-mounted /boot) generated without access to
# @snapshots. Divert it to /bin/true for the container run; the host runs
# the authoritative update-grub after commit.
suppress_staging_update_grub() {
    local root="$1"
    # dpkg-divert (not a plain overwrite) so an apt upgrade of grub2-common
    # inside the container still unpacks cleanly (dpkg honors diversions).
    # Only plant the symlink when the divert succeeded: otherwise the
    # symlink+restore would delete the tree's REAL update-grub.
    if chroot "$root" dpkg-divert --local --rename \
        --divert /usr/sbin/update-grub.freshroot-diverted \
        --add /usr/sbin/update-grub >/dev/null 2>&1; then
        ln -sf /bin/true "${root}/usr/sbin/update-grub"
    else
        warn "could not divert update-grub in staging — the container may write grub.cfg"
    fi
}
restore_staging_update_grub() {
    local root="$1"
    if [[ -L "${root}/usr/sbin/update-grub" && \
          "$(readlink "${root}/usr/sbin/update-grub")" == "/bin/true" ]]; then
        rm -f "${root}/usr/sbin/update-grub"
        chroot "$root" dpkg-divert --local --rename \
            --remove /usr/sbin/update-grub >/dev/null 2>&1 || true
    fi
}

# ── Sanity checks ────────────────────────────────────────────────────
[[ $(id -u) -eq 0 ]] || die "must be run as root"

# Acquire an exclusive lock so timer and manual runs don't collide
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "Another freshroot-update is already running. Exiting." >&2
    exit 0
fi

mkdir -p "$LOG_DIR"
info "=== freshroot-update started ==="

# ── Resolve the btrfs device backing root ────────────────────────────
resolve_btrfs_device() {
    local dev
    dev=$(findmnt -n -o SOURCE / | head -1)
    # Strip subvol path if present (e.g. /dev/mapper/crypt[@rootfs])
    dev="${dev%%\[*}"
    if [[ -z "$dev" ]]; then
        die "cannot determine btrfs device for /"
    fi
    echo "$dev"
}
BTRFS_DEV=$(resolve_btrfs_device)
info "BTRFS device: $BTRFS_DEV"

# ── Mount top-level btrfs volume ─────────────────────────────────────
mkdir -p "$TOPLEVEL"
mount -t btrfs -o subvolid=5 "$BTRFS_DEV" "$TOPLEVEL" || die "failed to mount top-level"
info "top-level mounted at $TOPLEVEL"

SNAP_PATH="${TOPLEVEL}/${SNAPSHOTS_DIR}"
STAGING_PATH="${TOPLEVEL}/${STAGING_SUBVOL}"

if [[ ! -d "$SNAP_PATH" ]]; then
    die "snapshots directory not found at ${SNAP_PATH}"
fi

# ── Determine the lineage to operate on ──────────────────────────────
CUR_LINEAGE=$(current_lineage)
TARGET_LINEAGE="${LINEAGE_FLAG:-$CUR_LINEAGE}"
info "lineage: ${TARGET_LINEAGE} (booted: ${CUR_LINEAGE})"

# ── Find the source snapshot ─────────────────────────────────────────
# --from REF (snapshot name or lineage), else the target lineage's latest.
# SYNC: resolve_from_ref is copied in freshroot-install — fix both.
resolve_from_ref() {
    local ref="$1" cand
    cand="${ref#"${SNAPSHOTS_DIR}"/}"
    if [[ -d "${SNAP_PATH}/${cand}" ]] && \
       btrfs property get "${SNAP_PATH}/${cand}" ro 2>/dev/null | grep -q 'ro=true'; then
        echo "${SNAP_PATH}/${cand}"
        return
    fi
    latest_in_lineage "$ref"
}

# Any read-only root.* subvolume at all — including names without a
# parseable timestamp (e.g. a hand-made root.golden), which never count as
# "latest" but must block the initial-snapshot bootstrap path.
has_any_ro_root_snapshot() {
    local d
    for d in "${SNAP_PATH}"/root.*/; do
        [[ -d "$d" ]] || continue
        if btrfs property get "${d%/}" ro 2>/dev/null | grep -q 'ro=true'; then
            return 0
        fi
    done
    return 1
}

LATEST=""
if [[ -n "$FROM_REF" ]]; then
    LATEST=$(resolve_from_ref "$FROM_REF")
    [[ -n "$LATEST" ]] || die "--from: no snapshot or lineage matches '${FROM_REF}'"
else
    LATEST=$(latest_in_lineage "$TARGET_LINEAGE")
fi

if [[ -z "$LATEST" ]]; then
    if has_any_ro_root_snapshot; then
        die "no snapshots in lineage '${TARGET_LINEAGE}' — pick a source with --lineage/--from (snapshots without a parseable timestamp can be staged with --from <name>), or create the lineage with freshroot-install"
    fi
    # No snapshots at all: create the initial one from the root subvolume,
    # but only into the lineage @ actually belongs to.
    AT_LINEAGE=$(lineage_of_root "${TOPLEVEL}/${ROOT_SUBVOL}")
    if [[ "$AT_LINEAGE" != "$TARGET_LINEAGE" ]]; then
        die "no snapshots exist and ${ROOT_SUBVOL} is lineage '${AT_LINEAGE}', not '${TARGET_LINEAGE}' — use freshroot-install to create a new lineage"
    fi
    if [[ "$AT_LINEAGE" != "unknown" ]]; then
        INITIAL_NAME="root.${AT_LINEAGE}.${TS}"
    else
        INITIAL_NAME="root.${TS}"
    fi
    info "no snapshots found — creating initial snapshot from ${ROOT_SUBVOL}"
    btrfs subvolume snapshot -r "${TOPLEVEL}/${ROOT_SUBVOL}" \
        "${SNAP_PATH}/${INITIAL_NAME}" || die "failed to create initial snapshot"
    LATEST="${SNAP_PATH}/${INITIAL_NAME}"
    info "initial snapshot created: $LATEST"
fi
info "source snapshot: $LATEST"

# ── Clean up any leftover staging subvolume ──────────────────────────
if btrfs subvolume show "$STAGING_PATH" &>/dev/null; then
    warn "stale staging subvolume found — deleting"
    btrfs subvolume delete "$STAGING_PATH" || die "cannot delete stale staging"
fi

# ── Create writable staging clone ────────────────────────────────────
info "creating staging subvolume from snapshot"
btrfs subvolume snapshot "$LATEST" "$STAGING_PATH" || die "failed to create staging snapshot"

# ── Prepare bind mounts for boot/EFI inside staging ─────────────────
mkdir -p "${STAGING_PATH}${BOOT_PARTITION}"
mount --bind "$BOOT_PARTITION" "${STAGING_PATH}${BOOT_PARTITION}" \
    || die "failed to bind-mount $BOOT_PARTITION"

if [[ -n "$EFI_PARTITION" && "$EFI_PARTITION" != "$BOOT_PARTITION" ]]; then
    mkdir -p "${STAGING_PATH}${EFI_PARTITION}"
    mount --bind "$EFI_PARTITION" "${STAGING_PATH}${EFI_PARTITION}" \
        || die "failed to bind-mount $EFI_PARTITION"
fi

# ── Persist the apt cache across updates ─────────────────────────────
# Bind the @apt-cache subvolume into the container so downloaded .debs
# aren't discarded when @staging is deleted.
APT_CACHE_BIND=("--bind=${TOPLEVEL}/@apt-cache:/var/cache/apt")

# ── Expose btrfs top-level (subvolid=5) inside the container ─────────
# Lets a repo's install.sh manage top-level subvolumes, e.g.:
#   btrfs subvolume create /run/freshroot-toplevel/@whatever
# CAP_SYS_ADMIN is in nspawn's default capability set and seccomp is
# disabled below, so subvolume operations work without extra flags.
# Note: this exposes ALL subvolumes (including @home, @log, @snapshots)
# rw to the container — only list trusted entries in REPOS.
TOPLEVEL_BIND=("--bind=${TOPLEVEL}:/run/freshroot-toplevel")

# ── Build extra bind-mount flags from BIND_MOUNTS ────────────────────
# Each entry is "HOST:CONTAINER[:ro]". Read-only entries become
# --bind-ro=HOST:CONTAINER, others become --bind=HOST:CONTAINER.
EXTRA_BINDS=()
for _bm in "${BIND_MOUNTS[@]:-}"; do
    [[ -z "$_bm" ]] && continue
    _host="${_bm%%:*}"
    _rest="${_bm#*:}"
    if [[ "$_rest" == *:ro ]]; then
        _container="${_rest%:ro}"
        [[ -e "$_host" ]] || { warn "BIND_MOUNTS: host path missing, skipping: $_host"; continue; }
        EXTRA_BINDS+=("--bind-ro=${_host}:${_container}")
        info "bind-mount (ro): $_host -> $_container"
    else
        _container="$_rest"
        [[ -e "$_host" ]] || { warn "BIND_MOUNTS: host path missing, skipping: $_host"; continue; }
        EXTRA_BINDS+=("--bind=${_host}:${_container}")
        info "bind-mount (rw): $_host -> $_container"
    fi
done

# ── Protect kernels referenced by existing snapshots ─────────────────
# Scan all snapshots' /usr/lib/modules/ to find kernel versions in use,
# then apt-mark hold the corresponding packages inside the staging
# subvolume so that apt full-upgrade / autoremove cannot remove them.
# Holds are convergent: holds for kernels no longer referenced by any
# snapshot (or @) are released first, so pruned lineages free their
# kernels for autoremove instead of pinning /boot forever.
protect_snapshot_kernels() {
    local snap_dir="$1" staging="$2"
    local -A in_use=()

    # Collect kernel versions from all read-only snapshots
    for snap in "${snap_dir}"/*/; do
        [[ -d "${snap}usr/lib/modules" ]] || continue
        for mod_dir in "${snap}usr/lib/modules"/*/; do
            [[ -d "$mod_dir" ]] || continue
            local kver
            kver=$(basename "$mod_dir")
            in_use["$kver"]=1
        done
    done

    # Also protect kernels from the root subvolume (@)
    if [[ -d "${TOPLEVEL}/${ROOT_SUBVOL}/usr/lib/modules" ]]; then
        for mod_dir in "${TOPLEVEL}/${ROOT_SUBVOL}/usr/lib/modules"/*/; do
            [[ -d "$mod_dir" ]] || continue
            local kver
            kver=$(basename "$mod_dir")
            in_use["$kver"]=1
        done
    fi

    # Also protect kernels from the pinned base (@base), if present — the
    # convergent hold-release below must never see @base's kernel as
    # unreferenced, or autoremove could take it from the shared /boot.
    if [[ -d "${TOPLEVEL}/${BASE_SUBVOL}/usr/lib/modules" ]]; then
        for mod_dir in "${TOPLEVEL}/${BASE_SUBVOL}/usr/lib/modules"/*/; do
            [[ -d "$mod_dir" ]] || continue
            local kver
            kver=$(basename "$mod_dir")
            in_use["$kver"]=1
        done
    fi

    # Release stale holds (kernel packages whose version is now unreferenced).
    # Only packages whose stripped remainder LOOKS like a kernel version are
    # candidates — meta/unsigned/vendor names (linux-image-generic,
    # linux-image-unsigned-<kver>, linux-modules-nvidia-*) were never held by
    # this tool and admin holds on them must survive.
    local held unhold_pkgs=()
    held=$(chroot "$staging" apt-mark showhold 2>/dev/null \
           | grep -E '^(linux-image|linux-modules|linux-modules-extra)-' || true)
    while IFS= read -r pkg; do
        [[ -z "$pkg" ]] && continue
        local kv="$pkg"
        kv="${kv#linux-image-}"
        kv="${kv#linux-modules-extra-}"
        kv="${kv#linux-modules-}"
        [[ "$kv" =~ ^[0-9]+\.[0-9]+ ]] || continue
        if [[ -z "${in_use[$kv]:-}" ]]; then
            unhold_pkgs+=("$pkg")
        fi
    done <<< "$held"
    if [[ ${#unhold_pkgs[@]} -gt 0 ]]; then
        info "releasing ${#unhold_pkgs[@]} stale kernel hold(s)"
        chroot "$staging" apt-mark unhold "${unhold_pkgs[@]}" >/dev/null 2>&1 || true
    fi

    if [[ ${#in_use[@]} -eq 0 ]]; then
        info "no kernel versions found in snapshots — skipping hold"
        return
    fi

    # Build the list of packages to hold inside the staging chroot
    local hold_pkgs=()
    for kver in "${!in_use[@]}"; do
        for prefix in linux-image linux-modules linux-modules-extra; do
            # Only hold if the package is actually installed in staging
            if chroot "$staging" dpkg -s "${prefix}-${kver}" &>/dev/null; then
                hold_pkgs+=("${prefix}-${kver}")
            fi
        done
    done

    if [[ ${#hold_pkgs[@]} -gt 0 ]]; then
        info "holding ${#hold_pkgs[@]} kernel package(s) referenced by snapshots/@/${BASE_SUBVOL}"
        chroot "$staging" apt-mark hold "${hold_pkgs[@]}" >/dev/null 2>&1 || true
        for pkg in "${hold_pkgs[@]}"; do
            info "  held: $pkg"
        done
    fi
}

protect_snapshot_kernels "$SNAP_PATH" "$STAGING_PATH"

# ── Run updates inside nspawn container ──────────────────────────────
# Disable nspawn's default seccomp filter. Network-heavy workloads
# (apt, git clone) are syscall-heavy; the filter adds measurable
# overhead. Staging runs trusted code, so the security trade-off is
# acceptable. Set SYSTEMD_LOG_SECCOMP=1 externally to debug.
export SYSTEMD_SECCOMP=0

NSPAWN_RC=0
suppress_staging_update_grub "$STAGING_PATH"

if [[ $INTERACTIVE -eq 1 ]]; then
    info "entering interactive nspawn shell — exit 0 to snapshot, non-zero to abort"
    info "(update-grub is disabled inside staging; the host runs it after commit)"

    NSPAWN_ARGS=(
        --directory="$STAGING_PATH"
        --resolv-conf=bind-stub
        --setenv=DEBIAN_FRONTEND=noninteractive
        --console=interactive
        "${APT_CACHE_BIND[@]}"
        "${TOPLEVEL_BIND[@]}"
        "${EXTRA_BINDS[@]}"
    )

    if [[ $GUI -eq 1 ]]; then
        # Detect the calling user's UID (works through sudo)
        CALLER_UID="${SUDO_UID:-1000}"
        XDG_DIR="/run/user/${CALLER_UID}"

        NSPAWN_ARGS+=(
            --bind=/dev
            --bind=/tmp/.X11-unix
            --property=DeviceAllow=/dev/dri/card0
            --property=DeviceAllow=/dev/dri/renderD128
        )

        # Bind Wayland/PipeWire/PulseAudio sockets if available
        [[ -d "$XDG_DIR" ]] && NSPAWN_ARGS+=(--bind="$XDG_DIR")

        NSPAWN_ARGS+=(
            --setenv=DISPLAY="${DISPLAY:-:0}"
            --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
            --setenv=XDG_RUNTIME_DIR="$XDG_DIR"
        )

        # Pass through DBUS session bus if available
        DBUS_SOCK="${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_DIR}/bus}"
        NSPAWN_ARGS+=(--setenv=DBUS_SESSION_BUS_ADDRESS="$DBUS_SOCK")

        info "GUI passthrough enabled (display, GPU, audio sockets)"
    fi

    systemd-nspawn "${NSPAWN_ARGS[@]}" \
        /bin/bash --norc --noprofile -c 'set +u; exec bash -l' || NSPAWN_RC=$?

elif [[ $PROVISION_ONLY -eq 1 ]]; then
    info "entering nspawn container for cloud-init provisioning"
    systemd-nspawn \
        --directory="$STAGING_PATH" \
        --resolv-conf=bind-stub \
        --setenv=DEBIAN_FRONTEND=noninteractive \
        "${APT_CACHE_BIND[@]}" \
        "${TOPLEVEL_BIND[@]}" \
        "${EXTRA_BINDS[@]}" \
        --quiet \
        --console=pipe \
        /bin/bash -e <<'INNER' 2>&1 | tee -a "$LOG_FILE" || NSPAWN_RC=${PIPESTATUS[0]}

# ── Cloud-init provisioning ─────────────────────────────────────────
echo "==> Running cloud-init provisioning"
cloud-init init --local
cloud-init init
cloud-init modules --mode=config
cloud-init modules --mode=final

# Remove the first-boot service so it doesn't run again from the new snapshot
rm -f /etc/systemd/system/freshroot-provision.service
rm -f /etc/systemd/system/multi-user.target.wants/freshroot-provision.service

INNER

else
    # Serialize REPOS array for passing into nspawn
    REPOS_JOINED=""
    for _repo in "${REPOS[@]}"; do
        [[ -n "$_repo" ]] && REPOS_JOINED+="${_repo}"$'\n'
    done

    info "entering nspawn container for updates"
    systemd-nspawn \
        --directory="$STAGING_PATH" \
        --resolv-conf=bind-stub \
        --setenv=DEBIAN_FRONTEND=noninteractive \
        --setenv=_FRESHROOT_REPOS="$REPOS_JOINED" \
        "${APT_CACHE_BIND[@]}" \
        "${TOPLEVEL_BIND[@]}" \
        "${EXTRA_BINDS[@]}" \
        --quiet \
        --console=pipe \
        /bin/bash -e <<'INNER' 2>&1 | tee -a "$LOG_FILE" || NSPAWN_RC=${PIPESTATUS[0]}

# ── System updates ──────────────────────────────────────────────────
apt-get update
apt-get full-upgrade -y
apt-get autoremove -y

# ── Cloud-init provisioning ─────────────────────────────────────────
echo "==> Running cloud-init provisioning"
cloud-init init --local
cloud-init init
cloud-init modules --mode=config
cloud-init modules --mode=final

# ── Run post-update scripts ─────────────────────────────────────────
while IFS= read -r repo; do
    [[ -z "$repo" ]] && continue
    if [[ "$repo" == local://* ]]; then
        # Local path (typically a bind-mounted dir): run install.sh in place
        path="${repo#local://}"
        if [[ ! -d "$path" ]]; then
            echo "WARNING: local path not found: $path — skipping" >&2
            continue
        fi
        if [[ -x "$path/install.sh" ]]; then
            echo "==> Running install.sh from $path (local)"
            (cd "$path" && ./install.sh)
        else
            echo "WARNING: no executable install.sh in $path — skipping" >&2
        fi
    else
        echo "==> Cloning $repo"
        work=$(mktemp -d /tmp/freshroot-repo.XXXXXX)
        git clone --depth=1 "$repo" "$work"
        if [[ -x "$work/install.sh" ]]; then
            echo "==> Running install.sh from $repo"
            (cd "$work" && ./install.sh)
        else
            echo "WARNING: no executable install.sh in $repo — skipping" >&2
        fi
        rm -rf "$work"
    fi
done <<< "${_FRESHROOT_REPOS:-}"

INNER
fi

restore_staging_update_grub "$STAGING_PATH"

# Unmount boot/EFI before snapshotting
umount -R "${STAGING_PATH}${BOOT_PARTITION}" 2>/dev/null || true

if [[ $NSPAWN_RC -ne 0 ]]; then
    die "nspawn update failed (exit $NSPAWN_RC) — staging retained at ${STAGING_SUBVOL}"
fi

# ── Determine the lineage label for the new snapshot ─────────────────
# --lineage wins; a custom source label (name label that differs from the
# tree's os-release-derived lineage) sticks; otherwise re-derive from the
# staged tree so a release upgrade performed in --shell lands in its new
# lineage automatically.
SRC_LABEL=$(snap_label "$LATEST")
if [[ -n "$LINEAGE_FLAG" ]]; then
    NEW_LINEAGE="$LINEAGE_FLAG"
elif [[ -n "$SRC_LABEL" && "$SRC_LABEL" != "$(lineage_of_root "$LATEST")" ]]; then
    NEW_LINEAGE="$SRC_LABEL"
else
    NEW_LINEAGE=$(lineage_of_root "$STAGING_PATH")
fi

NEW_TS="$(date -u +%Y%m%dT%H%M%S)"
if [[ -n "$NEW_LINEAGE" && "$NEW_LINEAGE" != "unknown" ]]; then
    NEW_NAME="root.${NEW_LINEAGE}.${NEW_TS}"
else
    warn "cannot resolve staged tree's lineage — committing with a legacy name"
    NEW_NAME="root.${NEW_TS}"
fi

# ── Create new read-only snapshot from updated staging ───────────────
NEW_SNAP="${SNAP_PATH}/${NEW_NAME}"
info "creating new read-only snapshot: $NEW_SNAP"
btrfs subvolume snapshot -r "$STAGING_PATH" "$NEW_SNAP" \
    || die "failed to create new read-only snapshot"

# Delete the staging subvolume
btrfs subvolume delete "$STAGING_PATH" || warn "could not delete staging subvol"
info "staging subvolume removed"

ensure_default_lineage "$CUR_LINEAGE"

# ── Prune old snapshots ─────────────────────────────────────────────
prune_snapshots

# ── Update GRUB to pick up the new snapshot ──────────────────────────
# 06_freshroot self-mounts /.snapshots when needed.
info "regenerating GRUB configuration"
update-grub 2>&1 | tee -a "$LOG_FILE" || warn "update-grub failed"

info "=== freshroot-update completed successfully ==="
info "New snapshot ${NEW_NAME} is ready. Reboot to apply."
